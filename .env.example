# =============================================================================
# Ilova
# =============================================================================
# production — JSON loglar, development — o'qish uchun qulay rangli loglar
APP_ENV=production
# debug | info | warn | error
LOG_LEVEL=info

# =============================================================================
# Telegram
# =============================================================================
# @BotFather dan olingan token (majburiy)
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Long polling kutish vaqti
TELEGRAM_POLL_TIMEOUT=10s
# To'xtatishda ishlayotgan generatsiyalarni kutish vaqti
SHUTDOWN_TIMEOUT=60s

# =============================================================================
# Sun'iy intellekt
# =============================================================================
# gemini | openai | deepseek
AI_PROVIDER=gemini

# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# "gemini-flash-latest" — eng so'nggi Flash modelga ishora qiluvchi alias.
# Barqaror natija uchun aniq versiyani yozish mumkin, masalan: gemini-2.5-flash
GEMINI_MODEL=gemini-flash-latest

# OpenAI (yoki OpenAI bilan mos API: OPENAI_BASE_URL ni o'zgartiring)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# deepseek-flash — tez va arzon; deepseek-v4-pro — kuchliroq, lekin sekinroq va qimmatroq
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Fikrlash (thinking) rejimi: true — chuqurroq, lekin bir necha barobar sekin va qimmat.
# Matn yozish uchun false tavsiya etiladi.
DEEPSEEK_THINKING=false

# 0..2 oralig'ida. Bo'sh qoldirilsa — modelning standart qiymati ishlatiladi.
# (Reasoning modellari va DeepSeek fikrlash rejimi bu qiymatni e'tiborsiz qoldiradi.)
AI_TEMPERATURE=0.7
# Bitta javob uzunligi chegarasi (tokenlarda). Bo'sh yoki 0 — provayder standarti
# (DeepSeek fikrlashsiz rejimda — 16384). "uzunlik chegarasida qirqildi" xatosi
# chiqsa, oshiring.
AI_MAX_TOKENS=
# Bitta AI so'rovi uchun maksimal vaqt
AI_TIMEOUT=120s
# Vaqtinchalik xatolarda (429, 5xx, buzilgan JSON) qayta urinishlar soni
AI_MAX_RETRIES=2
# Mustaqil ish/amaliy topshiriq bo'limlari parallel yoziladi: bir vaqtdagi so'rovlar soni.
# Gemini bepul tarifida (daqiqasiga so'rovlar cheklangan) 1-2 qo'ying.
AI_PARALLEL_REQUESTS=3

# =============================================================================
# Rasm generatsiyasi (rasmli dizaynlar: Jurnal, Tabiat, Okean, Shom)
# =============================================================================
# DeepSeek (yoki boshqa matn provayderi) har bir slayd uchun rasm tavsifini
# yozadi, rasmni esa AI rasm modeli chizadi. Ikki tarif bor; hozircha ikkalasi
# ham OpenAI'da ishlaydi:
#   openai — OpenAI gpt-image-2, low sifat ≈ $0.005/rasm (taqdimotga ≈ $0.03–0.06)
#   gemini — Gemini Nano Banana 2.1, 1K  ≈ $0.034/rasm (taqdimotga ≈ $0.17–0.40)
# Kalitlar yuqoridagi OPENAI_API_KEY va GEMINI_API_KEY dan olinadi
# (AI_PROVIDER=deepseek bo'lsa ham). Ikkala rasm modelida bepul tarif yo'q —
# hisobda billing yoqilgan bo'lishi kerak. Kalit bo'lmasa, provayder ulanmaydi;
# birorta ham provayder bo'lmasa, rasmli dizaynlar rasm o'rnida bezakli fon
# bilan chiqadi.
#
# Har bir tarifga qaysi provayder: openai | gemini | none
# (Gemini billingi yoqilgach, premium uchun yana gemini qo'yish mumkin.)
IMAGE_STANDARD_PROVIDER=openai
IMAGE_PREMIUM_PROVIDER=openai
# Tarifi belgilanmagan foydalanuvchilar uchun: standard | premium.
# Foydalanuvchining shaxsiy tarifi bazada sessions.plan ustunida
# ('premium' yoki 'standard'; bo'sh — shu qiymat). Masalan, o'zingizda sinash uchun:
#   UPDATE sessions SET plan='premium' WHERE user_id=<telegram_id>;
IMAGE_DEFAULT_TIER=standard

# OpenAI rasm modeli va sifati: low | medium (≈ $0.041/rasm) | high | auto
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=low
# Gemini rasm modeli va o'lchami: 1K | 2K | 4K (bo'sh — modelning standarti, 1K)
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_IMAGE_SIZE=

# Bitta rasm uchun maksimal vaqt (rasm chizish 10–30 soniya oladi)
IMAGE_TIMEOUT=90s
# Bitta taqdimot ichida bir vaqtda chiziladigan rasmlar soni
IMAGE_PARALLEL_REQUESTS=4
# Asosiy provayder ishlamasa (xato, limit, kontent filtri), rasmni boshqa
# tarif provayderidan so'rash (ikkala tarif bir xil provayderda bo'lsa, ta'siri
# yo'q). Diqqat: tariflardan biri Gemini bo'lsa, OpenAI ishlamay qolganda rasmlar
# qimmatroq Gemini'da chiziladi. Xarajatni qat'iy cheklash uchun — false.
IMAGE_FALLBACK=true

# =============================================================================
# PostgreSQL
# =============================================================================
# Docker Compose'da DB_HOST avtomatik "postgres" ga o'rnatiladi
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=presentation_bot
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
# Baza hali tayyor bo'lmasa, ulanishga necha marta urinish va oradagi pauza
DB_CONNECT_RETRIES=10
DB_CONNECT_DELAY=3s

# =============================================================================
# Fayl generatsiyasi
# =============================================================================
# Taqdimot (.pptx) asosiy paketi: undan faqat slayd master va mavzu (theme) olinadi.
# Slaydlarning o'zi tanlangan dizaynda (akademik, zamonaviy, minimal, texno va
# rasmli: jurnal, tabiat, okean, shom) koddan chiziladi — internal/generator/themes*.go.
# Shu papkadagi designs.png bot dizayn tanlashda ko'rsatadigan rasm
# (scripts/design_preview.py bilan yangilanadi).
# Mustaqil ish va amaliy topshiriq (.docx) shablonsiz yaratiladi.
TEMPLATE_PATH=templates/template.pptx
# .docx titul varag'ining eng yuqori qatori. Chiqarmaslik uchun "-" yozing.
DOCUMENT_HEADER=O'ZBEKISTON RESPUBLIKASI OLIY TA'LIM, FAN VA INNOVATSIYALAR VAZIRLIGI
# Vaqtinchalik fayllar papkasi (bo'sh bo'lsa — tizimning vaqtinchalik papkasi)
OUTPUT_DIR=
# Bir vaqtning o'zida bajariladigan generatsiyalar soni (qolganlari navbatda kutadi)
MAX_CONCURRENT_JOBS=4
# Bitta generatsiya (AI + fayl + yuborish) uchun maksimal vaqt.
# Hujjat bir necha AI so'rovi bilan yoziladi, shuning uchun zaxira bilan.
JOB_TIMEOUT=10m

# =============================================================================
# Cheklovlar
# =============================================================================
# Taqdimot: umumiy slaydlar soni chegaralari (titul va yakuniy slayd ham kiradi)
MIN_SLIDES=5
MAX_SLIDES=25
# Mustaqil ish / amaliy topshiriq: umumiy sahifalar soni (titul, reja va adabiyotlar ham kiradi)
MIN_PAGES=5
MAX_PAGES=30

# =============================================================================
# To'lov va admin
# =============================================================================
# false — barcha ishlar bepul (to'lov so'ralmaydi)
PAYMENT_ENABLED=true
# To'lov qabul qilinadigan karta (foydalanuvchiga ko'rsatiladi). Chekdagi
# qabul qiluvchi kartaning oxirgi 4 raqami shu raqam bilan solishtiriladi.
PAYMENT_CARD_NUMBER=8600 0000 0000 0000
PAYMENT_CARD_HOLDER=
# Narxlar (so'mda): rasmli taqdimot va rasmsiz taqdimot / mustaqil ish / amaliy topshiriq
PRICE_PHOTO=10000
PRICE_PLAIN=7000
# Har bir foydalanuvchiga beriladigan bepul urinishlar soni
FREE_PHOTO=1
FREE_PLAIN=1
# Chekni o'qiydigan OpenAI vision modeli (OPENAI_API_KEY va OPENAI_BASE_URL
# ishlatiladi). Bo'sh — OPENAI_MODEL. Kalit bo'lmasa, barcha cheklar adminga
# yuboriladi. Chek tasdiqlanishi uchun: holat muvaffaqiyatli, summa kam emas,
# karta mos, sana buyurtmadan keyin va chek oldin ishlatilmagan bo'lishi kerak;
# aks holda chek ✅/❌ tugmalari bilan adminga yuboriladi.
PAYMENT_VISION_MODEL=gpt-4o-mini
PAYMENT_CHECK_TIMEOUT=60s
# Botga shu matnni yuborgan foydalanuvchi admin sifatida saqlanadi
# (xabar chatdan o'chiriladi). Admin buyruqlari: /report, /chek ID.
# Uzun va tasodifiy parol qo'ying (kamida 8 belgi).
ADMIN_PASSWORD=
